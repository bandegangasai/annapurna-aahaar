// Prisma Schema for Annapurna Aahaar
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("ADMIN")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String
  category    String           // "Papad", "Flours & Grains", "Spices", "Noodles & Instant Foods"
  imageUrl    String
  isFeatured  Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  weight    String   // e.g. "500g", "1 kg", "2 kg", "5 kg"
  unit      String   // e.g. "kg", "g", "pack"
  price     Float    // e.g. 150.0, 300.0, 100.0
  stock     Int      @default(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  address   String
  city      String
  district  String?  @default("Nirmal District")
  state     String   @default("Telangana")
  pincode   String   @default("504103")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  orders    Order[]
}

model Order {
  id                  String               @id @default(uuid())
  orderNumber         String               @unique // e.g. "AA-20260823-1001"
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status              String               @default("PENDING") // PENDING, ACCEPTED, REJECTED, PROCESSING, READY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentMethod       String               @default("OFFLINE") // "OFFLINE" (Cash on Delivery), "ONLINE" (Razorpay), "MANUAL_UPI"
  paymentStatus       String               @default("PENDING") // "PENDING", "PROCESSING", "PAID", "FAILED", "REFUNDED", "PENDING_VERIFICATION"
  subtotal            Float
  deliveryFee         Float                @default(0.0)
  total               Float
  deliveryAddress     String?
  city                String?
  district            String?
  state               String?
  pincode             String?
  customerNotes       String?
  adminNotes          String?
  razorpayOrderId     String?
  razorpayPaymentId   String?
  razorpaySignature   String?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  items               OrderItem[]
  payments            Payment[]
  statusHistory       OrderStatusHistory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  variantId           String
  productName         String   // backward-compatible alias
  variantName         String   // backward-compatible alias
  productNameSnapshot String   @default("") // frozen at time of order
  variantNameSnapshot String   @default("") // frozen at time of order
  weight              String?  // e.g. "500g", "1 kg"
  unit                String?  // e.g. "kg", "g", "pack"
  unitPrice           Float    @default(0.0) // frozen at time of order
  quantity            Int
  totalPrice          Float    @default(0.0) // quantity * unitPrice
  createdAt           DateTime @default(now())
}

model Payment {
  id                   String    @id @default(uuid())
  orderId              String
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway              String    @default("CASH_ON_DELIVERY") // RAZORPAY, MANUAL_UPI, CASH_ON_DELIVERY
  gatewayOrderId       String?
  gatewayPaymentId     String?
  transactionReference String?
  amount               Float
  currency             String    @default("INR")
  status               String    @default("PENDING") // PENDING, PROCESSING, PAID, FAILED, REFUNDED, PENDING_VERIFICATION
  paymentMethod        String    @default("OFFLINE")
  manualUpiPhone       String?   @default("9542826358")
  manualUpiRef         String?
  manualUpiNotes       String?
  verifiedBy           String?
  verifiedAt           DateTime?
  verificationNote     String?
  failureReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model OrderStatusHistory {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus      String
  note           String?
  changedBy      String   @default("SYSTEM") // "ADMIN", "CUSTOMER", or "SYSTEM"
  createdAt      DateTime @default(now())
}

model AuditLog {
  id        String     @id @default(uuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String     // e.g. "ORDER_ACCEPTED", "ORDER_REJECTED", "PRICE_UPDATED", "PAYMENT_VERIFIED"
  entity    String     // e.g. "Order", "ProductVariant", "Payment"
  entityId  String?
  details   String?
  timestamp DateTime   @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
