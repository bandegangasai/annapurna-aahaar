// Prisma Schema for Annapurna Aahaar
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("ADMIN")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String
  category    String           // "Papad", "Flours & Grains", "Spices", "Noodles & Instant Foods"
  imageUrl    String
  isFeatured  Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  weight    String   // e.g. "500g", "1 kg", "2 kg", "5 kg"
  unit      String   // e.g. "kg", "g", "pack"
  price     Float    // e.g. 150.0, 300.0, 100.0
  stock     Int      @default(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                String   @id @default(uuid())
  name              String
  phone             String   @unique
  email             String?
  preferredLanguage String   @default("ENGLISH") // "ENGLISH", "MARATHI", "HINDI", "TELUGU"
  address           String
  city              String
  district          String?  @default("Nirmal District")
  state             String   @default("Telangana")
  pincode           String   @default("504103")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  orders            Order[]
}

model Order {
  id                  String               @id @default(uuid())
  orderNumber         String               @unique // e.g. "AA-20260824-1001"
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderSource         String               @default("WEBSITE") // "WEBSITE", "IVR", "ADMIN", "PHONE"
  language            String               @default("ENGLISH") // "ENGLISH", "MARATHI", "HINDI", "TELUGU"
  callId              String?
  call                Call?                @relation(fields: [callId], references: [id], onDelete: SetNull)
  status              String               @default("PENDING") // PENDING, ACCEPTED, REJECTED, PROCESSING, READY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentMethod       String               @default("OFFLINE") // "OFFLINE" (Cash on Delivery), "ONLINE" (Razorpay), "MANUAL_UPI"
  paymentStatus       String               @default("PENDING") // "PENDING", "PROCESSING", "PAID", "FAILED", "REFUNDED", "PENDING_VERIFICATION"
  subtotal            Float
  deliveryFee         Float                @default(0.0)
  total               Float
  deliveryAddress     String?
  city                String?
  district            String?
  state               String?
  pincode             String?
  customerNotes       String?
  adminNotes          String?
  razorpayOrderId     String?
  razorpayPaymentId   String?
  razorpaySignature   String?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  items               OrderItem[]
  payments            Payment[]
  statusHistory       OrderStatusHistory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  variantId           String
  productName         String   // backward-compatible alias
  variantName         String   // backward-compatible alias
  productNameSnapshot String   @default("") // frozen at time of order
  variantNameSnapshot String   @default("") // frozen at time of order
  weight              String?  // e.g. "500g", "1 kg"
  unit                String?  // e.g. "kg", "g", "pack"
  unitPrice           Float    @default(0.0) // frozen at time of order
  quantity            Int
  totalPrice          Float    @default(0.0) // quantity * unitPrice
  createdAt           DateTime @default(now())
}

model Payment {
  id                   String    @id @default(uuid())
  orderId              String
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway              String    @default("CASH_ON_DELIVERY") // RAZORPAY, MANUAL_UPI, CASH_ON_DELIVERY
  gatewayOrderId       String?
  gatewayPaymentId     String?
  transactionReference String?
  amount               Float
  currency             String    @default("INR")
  status               String    @default("PENDING") // PENDING, PROCESSING, PAID, FAILED, REFUNDED, PENDING_VERIFICATION
  paymentMethod        String    @default("OFFLINE")
  manualUpiPhone       String?   @default("9542826358")
  manualUpiRef         String?
  manualUpiNotes       String?
  verifiedBy           String?
  verifiedAt           DateTime?
  verificationNote     String?
  failureReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model OrderStatusHistory {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus      String
  note           String?
  changedBy      String   @default("SYSTEM") // "ADMIN", "CUSTOMER", or "SYSTEM"
  createdAt      DateTime @default(now())
}

model Call {
  id             String           @id @default(uuid())
  callSid        String           @unique // Unique Call Session ID (Twilio/Exotel/Plivo)
  fromPhone      String           // Caller's phone number
  toPhone        String           @default("9347036152") // Dedicated IVR number 9347036152
  language       String           @default("ENGLISH") // "ENGLISH", "MARATHI", "HINDI", "TELUGU"
  startTime      DateTime         @default(now())
  endTime        DateTime?
  duration       Int              @default(0) // in seconds
  status         String           @default("IN_PROGRESS") // "RINGING", "IN_PROGRESS", "COMPLETED", "BUSY", "FAILED", "NO_ANSWER", "DISCONNECTED"
  selectedOption String?          // "1_ORDER", "2_TRACK", "3_CANCEL", "4_SUPPORT", "9_REPEAT"
  orderId        String?
  customerId     String?
  orders         Order[]
  recordingUrl   String?
  interactions   IvrInteraction[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model IvrInteraction {
  id         String   @id @default(uuid())
  callId     String
  call       Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  language   String   @default("ENGLISH")
  menu       String   // "LANGUAGE_MENU", "MAIN_MENU", "PRODUCT_MENU", "VARIANT_MENU", "CONFIRM_MENU", "TRACK_MENU", "CANCEL_MENU", "SUPPORT_MENU"
  dtmfInput  String?  // Digits pressed (e.g. "1", "2", "3", "4", "9", "0")
  action     String   // e.g. "LANGUAGE_SELECTED", "PRODUCT_SELECTED", "ORDER_CONFIRMED", "ORDER_CANCELLED", "ORDER_TRACKED", "SUPPORT_REQUESTED", "LANGUAGE_CHANGED"
  details    String?  // Human-readable summary of the step
  orderId    String?
  customerId String?
  timestamp  DateTime @default(now())
}

model IvrSession {
  id            String   @id @default(uuid())
  callSid       String   @unique
  fromPhone     String
  language      String   @default("ENGLISH") // "ENGLISH", "MARATHI", "HINDI", "TELUGU"
  currentMenu   String   @default("LANGUAGE_MENU")
  currentStep   String   @default("GREETING")
  customerId    String?
  orderId       String?
  cartData      String?  // JSON-serialized cart payload
  paymentMethod String?  @default("OFFLINE")
  sessionStatus String   @default("ACTIVE") // "ACTIVE", "COMPLETED", "ABANDONED"
  lastActivity  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CancellationRule {
  id               String   @id @default(uuid())
  orderStatus      String   @unique // "PENDING", "ACCEPTED", "PROCESSING", "READY", "OUT_FOR_DELIVERY", "DELIVERED"
  isCancellable    Boolean  @default(false)
  requiresAdminOtp Boolean  @default(false)
  description      String?
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id        String     @id @default(uuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String     // e.g. "ORDER_ACCEPTED", "ORDER_REJECTED", "PRICE_UPDATED", "PAYMENT_VERIFIED", "IVR_ORDER_CREATED"
  entity    String     // e.g. "Order", "ProductVariant", "Payment", "Call"
  entityId  String?
  details   String?
  timestamp DateTime   @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  subject   String?
  message   String
  callId    String?  // Optional link to IVR Call
  language  String?  @default("ENGLISH")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
