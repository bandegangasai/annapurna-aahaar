# ================================================================
# ANNAPURNA AHAAR — ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL for Neon/Supabase/Render or SQLite for Local)
DATABASE_URL="postgresql://username:password@hostname:5432/annapurna_db?sslmode=require"
# For Local SQLite: DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="generate_a_strong_random_jwt_secret_key_here"

# Frontend / Client Origin URL for CORS
CLIENT_URL="https://annapurna-aahaar.vercel.app"

# Business Information Placeholders
BUSINESS_NAME="Annapurna Aahaar"
BUSINESS_TAGLINE="Tradition in Every Grain."
BUSINESS_PHONE="+91 98765 43210"
BUSINESS_EMAIL="contact@annapurnaaahaar.in"
BUSINESS_ADDRESS="Near Traditional Grain Market, Industrial Area, India"
BUSINESS_WHATSAPP="+91 98765 43210"

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL="admin@annapurnaaahaar.in"
ADMIN_PASSWORD="YourStrongAdminPasswordHere!"
ADMIN_NAME="Annapurna Admin"

# Frontend Environment Variables (in frontend/.env)
VITE_API_URL="/api"
